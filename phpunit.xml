<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <!--
          Smoke: fast gate for every push/PR (~seconds, no MySQL seed).
          Full Unit/Feature stay local + nightly / workflow_dispatch.
        -->
        <testsuite name="Smoke">
            <file>tests/Unit/DeadlockSafeTest.php</file>
            <file>tests/Unit/EnvironmentSettingsTest.php</file>
            <file>tests/Unit/CentrixVersionTest.php</file>
            <file>tests/Unit/PhoneNumberTest.php</file>
            <file>tests/Unit/PasswordPolicyTest.php</file>
            <file>tests/Unit/ApiTokenCookieTest.php</file>
            <file>tests/Unit/ApiErrorPresenterTest.php</file>
            <file>tests/Unit/ApplicationProvisionerTest.php</file>
            <file>tests/Unit/CapabilityGateApplicationOverridesTest.php</file>
            <file>tests/Unit/WorkspaceResolverIndustryTest.php</file>
            <file>tests/Unit/OrganizationProvisioningChannelsTest.php</file>
            <file>tests/Unit/PackageFeatureCatalogTest.php</file>
            <file>tests/Unit/PlatformLicenceQuoteTest.php</file>
            <file>tests/Unit/LicencePeriodWindowTest.php</file>
            <file>tests/Unit/SalesVatCalculatorTest.php</file>
            <file>tests/Unit/SqlLikeSearchTest.php</file>
            <file>tests/Unit/DestructiveCommandsGuardTest.php</file>
        </testsuite>
        <!--
          Critical: always-on deploy gate for selling / auth / hotel / KRA / RBAC.
          Runs every push/PR (MySQL). Full Unit remains nightly / manual.
        -->
        <testsuite name="Critical">
            <file>tests/Unit/DeadlockSafeTest.php</file>
            <file>tests/Unit/DestructiveCommandsGuardTest.php</file>
            <file>tests/Unit/EnvironmentSettingsTest.php</file>
            <file>tests/Unit/OrderWorkflowServiceTest.php</file>
            <file>tests/Unit/CustomerRoutePolicyTest.php</file>
            <file>tests/Unit/CapabilityGateApplicationOverridesTest.php</file>
            <file>tests/Unit/CapabilityGateStockDeductionTest.php</file>
            <file>tests/Unit/WorkspaceResolverIndustryTest.php</file>
            <file>tests/Unit/KraComstorePluPayloadTest.php</file>
            <file>tests/Unit/KraDeviceFailurePluMatchTest.php</file>
            <file>tests/Unit/PosOfflineCheckoutIdempotencyTest.php</file>
            <file>tests/Unit/PickingListBuilderTest.php</file>
            <file>tests/Unit/PayrollPlatformConfigTest.php</file>
            <file>tests/Unit/StockReservationCartLineIdTest.php</file>
            <file>tests/Feature/BackofficeSalesCartTest.php</file>
            <file>tests/Feature/CustomerCreditLimitCheckoutTest.php</file>
            <file>tests/Feature/OrderWorkflowTransitionTest.php</file>
            <file>tests/Feature/DiscountApprovalCheckoutTest.php</file>
            <file>tests/Feature/HospitalityPosTest.php</file>
            <file>tests/Feature/ProductImageApiTest.php</file>
            <file>tests/Feature/WebCookieAuthTest.php</file>
            <file>tests/Feature/RolePermissionTest.php</file>
            <file>tests/Feature/ModuleScopedPermissionsTest.php</file>
            <file>tests/Feature/KraDeviceCheckoutTest.php</file>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="PRODUCT_SEARCH_FULLTEXT" value="false"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="MPESA_CALLBACK_IP_CHECK" value="false"/>
        <env name="CORS_ALLOWED_ORIGINS" value="http://localhost:3000"/>
        <env name="SANCTUM_TOKEN_EXPIRATION_MINUTES" value="1440"/>
        <env name="PLATFORM_REQUIRE_TWO_FACTOR" value="false"/>
    </php>
</phpunit>
