# DB_HOST_PRODUCTION=157.173.120.126
# DB_PORT_PRODUCTION=3306
# DB_DATABASE_PRODUCTION=centrix_erp
# DB_USERNAME_PRODUCTION=steve
# DB_PASSWORD_PRODUCTION=Kiarithaini@7066

DB_CONNECTION=mysql
DB_ALLOW_DESTRUCTIVE_COMMANDS=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost

PLATFORM_SUPER_ADMIN_EMAIL=alpacke.tech@gmail.com
PLATFORM_SUPER_ADMIN_PASSWORD=Kiarithaini7066@!

# Database backups (scheduler + platform super-admin)
BACKUP_DISK=local
BACKUP_PATH=backups/database
BACKUP_ENABLED=true
BACKUP_NOTIFY_EMAIL=alpacke.tech@gmail.com
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE_TIME=02:00

# Background report exports + row cache (must match k8s shared PVC: storage/app/private/backups/exports)
BACKGROUND_EXPORT_DIRECTORY=private/backups/exports

# Cloudflare R2 offsite backup upload (set credentials in Cloudflare dashboard)
BACKUP_R2_ENABLED=false
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT=
BACKUP_R2_REGION=auto
BACKUP_R2_PREFIX=backups/database
BACKUP_R2_PUBLIC_URL=

REVERB_APP_ID=361137
REVERB_APP_KEY=dv8udnhfzdqx04ec30w5
REVERB_APP_SECRET=ctulndn0lzupkvqcwcyy
